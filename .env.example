# Copy to `.env` at the repo root: `cp .env.example .env`. Never commit `.env`.
# Every app validates its variables at startup (zod in TypeScript, pydantic-settings in Python)
# and refuses to start if a required one is missing or malformed.

# ── App URLs and ports (local block 38000–38190) ──────────────────────────────
VIDYAM_APP_URL=http://localhost:38000
VIDYAM_WEB_PORT=38100
VIDYAM_API_PORT=38110
VIDYAM_AI_PORT=38120
VIDYAM_RENDER_HEALTH_PORT=38170
# Internal URLs between services (the browser only ever sees VIDYAM_APP_URL).
VIDYAM_API_INTERNAL_URL=http://localhost:38110
VIDYAM_AI_INTERNAL_URL=http://localhost:38120

# ── Local infrastructure (infra/docker/compose.yml; dev-only credentials) ─────
VIDYAM_DATABASE_URL=postgresql://vidyam:vidyam@localhost:38130/vidyam
VIDYAM_TEST_DATABASE_URL=postgresql://vidyam:vidyam@localhost:38130/vidyam_test
VIDYAM_QDRANT_URL=http://localhost:38140
VIDYAM_QDRANT_API_KEY=vidyam-local-qdrant-key
VIDYAM_QUEUE_REDIS_URL=redis://localhost:38150
VIDYAM_CACHE_REDIS_URL=redis://localhost:38151
VIDYAM_S3_ENDPOINT=http://localhost:38160
VIDYAM_S3_REGION=ap-south-1
VIDYAM_S3_ACCESS_KEY_ID=vidyam
VIDYAM_S3_SECRET_ACCESS_KEY=vidyam-local-secret
VIDYAM_SMTP_URL=smtp://localhost:38180

# ── LLM providers: read ONLY by the Python AI engine (apps/ai) ────────────────
# Claude: "aws" = Claude Platform on AWS (AWS credentials + workspace id),
#         "anthropic" = first-party Claude API (API key).
VIDYAM_CLAUDE_ENDPOINT=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_AWS_WORKSPACE_ID=
AWS_REGION=ap-south-1
OPENAI_API_KEY=
