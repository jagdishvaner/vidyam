{
  "name": "@vidyam/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NestJS API: auth, RBAC, business workflows, CRUD, quotas, SSE. Never calls an LLM (ADR 0003).",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:seed": "tsx scripts/seed.ts",
    "ingest": "tsx scripts/ingest.ts",
    "codegen": "tsx scripts/export-openapi.ts",
    "bootstrap": "tsx scripts/bootstrap-s3.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.4",
    "@temporalio/client": "1.24.0",
    "@thallesp/nestjs-better-auth": "2.8.0",
    "@vidyam/contracts": "workspace:*",
    "@vidyam/db": "workspace:*",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "ioredis": "6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "@vidyam/config": "workspace:*",
    "eslint": "10.13.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
