{
  "name": "@vidyam/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared UI components (shadcn/ui on Tailwind CSS 4) and the Vidyam theme.",
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./postcss.config": "./postcss.config.mjs",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.61.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "shadcn": "4.22.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vidyam/config": "workspace:*",
    "eslint": "10.13.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
