{
  "openapi": "3.0.0",
  "paths": {
    "/api/me": {
      "get": {
        "operationId": "MeController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "name": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string",
                      "format": "email",
                      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                    },
                    "platformRole": {
                      "nullable": true,
                      "type": "string",
                      "enum": [
                        "superadmin"
                      ]
                    },
                    "organization": {
                      "nullable": true,
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "name": {
                          "type": "string"
                        },
                        "slug": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "slug"
                      ],
                      "additionalProperties": false
                    },
                    "orgRole": {
                      "nullable": true,
                      "type": "string",
                      "enum": [
                        "admin",
                        "reviewer",
                        "teacher",
                        "content_operator"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "email",
                    "platformRole",
                    "organization",
                    "orgRole"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "tags": [
          "identity"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "SystemController_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "tags": [
          "system"
        ]
      }
    },
    "/api/system/status": {
      "get": {
        "operationId": "SystemController_status",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "services": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "service": {
                            "type": "string",
                            "enum": [
                              "api",
                              "ai",
                              "render"
                            ]
                          },
                          "version": {
                            "type": "string"
                          },
                          "ok": {
                            "type": "boolean"
                          },
                          "dependencies": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "name": {
                                  "type": "string"
                                },
                                "ok": {
                                  "type": "boolean"
                                },
                                "latencyMs": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 9007199254740991
                                },
                                "detail": {
                                  "nullable": true,
                                  "type": "string"
                                }
                              },
                              "required": [
                                "name",
                                "ok",
                                "latencyMs",
                                "detail"
                              ],
                              "additionalProperties": false
                            }
                          }
                        },
                        "required": [
                          "service",
                          "version",
                          "ok",
                          "dependencies"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "ok",
                    "services"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "tags": [
          "system"
        ]
      }
    },
    "/api/dashboard/summary": {
      "get": {
        "operationId": "DashboardController_summary",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sources": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "questions": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "documents": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "sources",
                    "questions",
                    "documents"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "tags": [
          "dashboard"
        ]
      }
    }
  },
  "info": {
