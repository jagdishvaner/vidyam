{
  "name": "@vidyam/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL schema (Drizzle), migrations, row-level security and seeds. The only place the schema changes.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "auth:generate": "auth generate --config scripts/better-auth.schema.ts --output src/schema/auth.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio --port 38190",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@vidyam/config": "workspace:*",
    "auth": "1.7.12",
    "better-auth": "1.7.12",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
