{
  "name": "@vidyam/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Single source of truth for shapes shared across services: DTOs, job payloads, paper JSON, events.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "generated"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "codegen": "tsx scripts/export-json-schema.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vidyam/config": "workspace:*",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
