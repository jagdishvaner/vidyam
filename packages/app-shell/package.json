    "better-auth": "1.7.12",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.104.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vidyam/api-client": "workspace:*",
    "@vidyam/config": "workspace:*",
    "@vidyam/contracts": "workspace:*",
    "@vidyam/ui": "workspace:*",
    "better-auth": "1.7.12",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
