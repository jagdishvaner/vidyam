{
  "name": "@vidyam/app-shell",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "What the web app and the admin app share: sign-in, session, API clients, locale routing, the header pieces and the auth redirect. Compiled by each Next.js app (transpilePackages).",
  "exports": {
    "./system-status": "./src/system-status.tsx",
    "./providers": "./src/providers.tsx",
    "./login-form": "./src/login-form.tsx",
    "./roles": "./src/roles.ts",
    "./proxy": "./src/proxy.ts",
    "./i18n/routing": "./src/i18n/routing.ts",
    "./i18n/navigation": "./src/i18n/navigation.ts",
    "./i18n/messages": "./src/i18n/messages.ts",
    "./client/*": "./src/client/*.ts",
    "./server/*": "./src/server/*.ts",
    "./shell/*": "./src/shell/*.tsx"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/react-query": "5.104.5",
