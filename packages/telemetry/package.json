{
  "name": "@vidyam/telemetry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OpenTelemetry tracing for the Node services (plan v3 step 31): off unless an OTLP endpoint is configured.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/instrumentation": "0.300.0",
    "@opentelemetry/instrumentation-express": "0.72.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/instrumentation-ioredis": "0.72.0",
    "@opentelemetry/instrumentation-pg": "0.77.0",
    "@opentelemetry/instrumentation-undici": "0.34.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vidyam/config": "workspace:*",
    "eslint": "10.13.0",
    "typescript": "6.0.3"
  }
}
